{
  "spring": {
    "application": {
      "name": "PricingService"
    }
  },
  "eureka": {
    "client": {
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": true,
      "serviceUrl": "http://localhost:8761/eureka/",
      "validateCertificates": false
    },
    "instance": {
      "appName": "PricingService",
      "hostName": "localhost",
      "port": 5040
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
